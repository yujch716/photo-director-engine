# 이 파일을 복사해 .env 로 만들고 값을 채우세요:  cp .env.example .env
# (.env 는 .gitignore 로 커밋되지 않습니다.)

# Kakao Local REST API 키 (주변 랜드마크 검색용)
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# ---------------------------------------------------------------------------
# best 크롭 매칭용 단일 patch 임베딩 DB는 환경변수가 아니라 config/ 아래 고정 파일에서 읽습니다:
#   config/dinov2_patch_embeddings.npy   shape (N, P, D)   patch 임베딩
#   config/metadata.json                 길이 N            각 항목의 "path"를 라벨로 사용
# 이 파일들이 없으면 /capture 는 죽지 않고 best/drone_offset 만 null 로 응답합니다.
# ---------------------------------------------------------------------------
